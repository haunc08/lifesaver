{
  "name": "lifesaver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src e2e",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "test:e2e": "playwright test --project=chrome",
    "test:e2e:safari": "playwright test --project=safari",
    "demo:sheet": "DEMO=1 playwright test --project=chrome demo-shots && node scripts/demo-sheet.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
